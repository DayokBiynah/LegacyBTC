<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/screenScroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/screen_padding">
        <TextView android:id="@+id/title" style="@style/UiTitle" android:text="@string/send" />
        <TextView android:id="@+id/networkStatusText" style="@style/UiNetwork" android:text="@string/testnet_only" />
        <LinearLayout style="@style/UiCard">
            <TextView style="@style/UiCaption" android:text="@string/available_balance_label" />
            <TextView android:id="@+id/balanceText" style="@style/UiSection" android:text="@string/balance_placeholder" />
        </LinearLayout>
        <LinearLayout style="@style/UiCard">
            <TextView style="@style/UiLabel" android:text="@string/recipient_hint" android:labelFor="@id/recipientInput" />
            <EditText android:id="@+id/recipientInput" style="@style/UiInput" android:inputType="textNoSuggestions" android:importantForAutofill="no" />
            <TextView style="@style/UiLabel" android:text="@string/amount_hint" android:labelFor="@id/amountInput" />
            <EditText android:id="@+id/amountInput" style="@style/UiInput" android:inputType="numberDecimal" android:importantForAutofill="no" />
            <TextView style="@style/UiLabel" android:text="@string/fee_hint" android:labelFor="@id/feeInput" />
            <EditText android:id="@+id/feeInput" style="@style/UiInput" android:inputType="number" android:importantForAutofill="no" android:text="@string/default_fee" />
            <TextView android:id="@+id/feeDescription" style="@style/UiCaption" android:text="@string/fee_description" />
        </LinearLayout>
        <TextView android:id="@+id/errorText" style="@style/UiFeedback" android:text="@string/empty" />
        <Button android:id="@+id/sendButton" style="@style/UiButtonPrimary" android:text="@string/review_send" />
        <TextView android:id="@+id/confirmationText" style="@style/UiFeedback" android:text="@string/empty" />
        <Button android:id="@+id/cancelButton" style="@style/UiButtonQuiet" android:text="@string/cancel" />
    </LinearLayout>
</ScrollView>