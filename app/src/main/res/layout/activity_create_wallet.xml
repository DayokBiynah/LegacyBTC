<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp">

    <!-- Displays the title of the wallet creation screen. -->
    <TextView
        android:id="@+id/createWalletTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Create Bitcoin Wallet"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="16dp" />

    <!-- Explains the purpose of the screen before wallet creation begins. -->
    <TextView
        android:id="@+id/createWalletDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Create a new self-custodial Bitcoin wallet. A recovery phrase will be generated and used to restore access to the wallet."
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginBottom="32dp" />

    <!-- Starts the Bitcoin wallet creation process when selected. -->
    <Button
        android:id="@+id/generateWalletButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Generate Wallet"
        android:layout_marginBottom="16dp" />

    <!-- Returns the user to the previous screen. -->
    <Button
        android:id="@+id/backButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Back" />

</LinearLayout>