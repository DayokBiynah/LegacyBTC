<?xml version='1.0' encoding='utf-8'?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/ui_background" />
            <stroke android:width="2dp" android:color="@color/ui_accent" />
            <corners android:radius="@dimen/control_radius" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/ui_background" />
            <stroke android:width="1dp" android:color="@color/ui_control_border" />
            <corners android:radius="@dimen/control_radius" />
        </shape>
    </item>
</selector>