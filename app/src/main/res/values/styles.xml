<?xml version='1.0' encoding='utf-8'?>
<resources>
    <style name="UiText" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/ui_text</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:lineSpacingExtra">4dp</item>
        <item name="android:layout_marginBottom">@dimen/space_medium</item>
    </style>
    <style name="UiTitle" parent="UiText">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:layout_marginBottom">@dimen/space_small</item>
    </style>
    <style name="UiSection" parent="UiText">
        <item name="android:textSize">@dimen/text_section</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:layout_marginTop">@dimen/space_small</item>
    </style>
    <style name="UiSupporting" parent="UiText">
        <item name="android:textColor">@color/ui_secondary</item>
    </style>
    <style name="UiCaption" parent="UiSupporting">
        <item name="android:textSize">@dimen/text_caption</item>
    </style>
    <style name="UiLabel" parent="UiText">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:layout_marginTop">@dimen/space_medium</item>
        <item name="android:layout_marginBottom">@dimen/space_small</item>
    </style>
    <style name="UiNetwork" parent="UiCaption">
        <item name="android:textColor">@color/ui_warning</item>
        <item name="android:layout_marginBottom">@dimen/space_large</item>
    </style>
    <style name="UiAddress" parent="UiCaption">
        <item name="android:textColor">@color/ui_text</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:background">@drawable/bg_address</item>
        <item name="android:padding">@dimen/space_medium</item>
        <item name="android:textIsSelectable">true</item>
        <item name="android:breakStrategy">simple</item>
        <item name="android:hyphenationFrequency">none</item>
    </style>
    <style name="UiFeedback" parent="UiCaption">
        <item name="android:background">@drawable/bg_feedback</item>
        <item name="android:padding">@dimen/space_medium</item>
        <item name="android:accessibilityLiveRegion">polite</item>
        <item name="android:minHeight">0dp</item>
    </style>
    <style name="UiNotice" parent="UiCaption">
        <item name="android:textColor">@color/ui_warning</item>
        <item name="android:background">@drawable/bg_notice</item>
        <item name="android:padding">@dimen/space_medium</item>
    </style>
    <style name="UiCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">@dimen/card_padding</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:layout_marginBottom">@dimen/space_large</item>
    </style>
    <style name="UiInput" parent="Widget.AppCompat.EditText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/control_height</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:padding">14dp</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/ui_text</item>
        <item name="android:textColorHint">@color/ui_secondary</item>
        <item name="android:layout_marginBottom">@dimen/space_medium</item>
        <item name="android:importantForAutofill">no</item>
    </style>
    <style name="UiButtonPrimary" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/control_height</item>
        <item name="android:layout_marginBottom">@dimen/space_small</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="cornerRadius">@dimen/control_radius</item>
        <item name="backgroundTint">@color/button_primary</item>
        <item name="android:textColor">@color/button_primary_text</item>
    </style>
    <style name="UiButtonSecondary" parent="UiButtonPrimary">
        <item name="backgroundTint">@color/ui_surface_high</item>
        <item name="android:textColor">@color/ui_text</item>
        <item name="strokeColor">@color/ui_control_border</item>
        <item name="strokeWidth">1dp</item>
    </style>
    <style name="UiButtonQuiet" parent="UiButtonSecondary">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="strokeWidth">0dp</item>
        <item name="android:textColor">@color/ui_secondary</item>
    </style>
    <style name="UiButtonDestructive" parent="UiButtonQuiet">
        <item name="android:textColor">@color/ui_error</item>
    </style>
    <style name="UiDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/ui_surface</item>
        <item name="colorOnSurface">@color/ui_text</item>
        <item name="colorPrimary">@color/ui_accent</item>
        <item name="android:colorBackground">@color/ui_surface</item>
    </style>
</resources>